{
  "branchSummary": {
    "skipPrompt": true
  },
  "defaultModel": "glm-5.2",
  "defaultProvider": "ali",
  "defaultThinkingLevel": "max",
  "followUpMode": "all",
  "lastChangelogVersion": "{{ (lookup('file', lookup('env', 'HOME') ~ '/.pi/agent/settings.json', errors='ignore') | default('{}', true) | from_json).lastChangelogVersion | default('0.0.0') }}",
  "packages": [
    "npm:pi-mcp-extension"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 9
  },
  "steeringMode": "all",
  "theme": "light",
  "treeFilterMode": "user-only",
  "tuiMode": "fullscreen"
}
